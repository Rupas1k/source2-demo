{
  "name": "source2-demo-inspector",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:wasm && vite",
    "build:wasm": "wasm-pack build wasm --target web --out-dir ../src/generated/wasm --out-name inspector --release",
    "check": "npm run build:wasm && tsc --noEmit",
    "build": "npm run check && vite build",
    "lint": "eslint .",
    "format": "prettier --write src vite.config.ts eslint.config.ts",
    "format:check": "prettier --check src vite.config.ts eslint.config.ts"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "virtua": "^0.56.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8"
  }
}
